{
    "name": "maxpertici/gutenberg-markup",
    "description": "Gutenberg block templates and utilities for the Markup package",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Max Pertici",
            "email": "hello@maxpertici.fr"
        }
    ],
    "autoload": {
        "psr-4": {
            "MaxPertici\\GutenbergMarkup\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MaxPertici\\GutenbergMarkup\\Tests\\": "tests/"
        }
    },
    "require": {
        "php": ">=8.1",
        "maxpertici/markup": "^0.9.3 || dev-main"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "scripts": {
        "lint": "find src -name '*.php' -print0 | xargs -0 -n1 php -l",
        "test": "phpunit --configuration phpunit.xml",
        "validate": [
            "@composer validate",
            "@lint",
            "@test"
        ]
    }
}
